{
  "name": "htmlpdfx.js",
  "version": "1.0.5",
  "description": "A lightweight HTML to PDF converter library based on jsPDF, supporting custom fonts, page breaks, repeat headers, and multi-page rendering",
  "main": "dist/htmlpdf.js",
  "module": "dist/htmlpdf.esm.js",
  "types": "htmlpdf.d.ts",
  "license": "MIT",
  "type": "module",
  "author": "melon587 <782331426@qq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/melon587/htmlpdf.js.git"
  },
  "homepage": "https://github.com/melon587/htmlpdf.js#readme",
  "bugs": {
    "url": "https://github.com/melon587/htmlpdf.js/issues"
  },
  "keywords": [
    "html",
    "pdf",
    "jspdf",
    "html-to-pdf",
    "pdf-converter",
    "page-break",
    "custom-fonts",
    "multi-page"
  ],
  "files": [
    "dist",
    "htmlpdf.d.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:min": "rollup -c --environment MINIFY",
    "dev": "rollup -c -w",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "release": "node release.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "25.0.8",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-terser": "0.4.4",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "kolorist": "^1.8.0",
    "prettier": "3.8.3",
    "rollup": "3.30.0",
    "vitepress": "1.6.4",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
